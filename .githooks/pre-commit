#!/usr/bin/env bash
# Block commits that add secrets. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
command -v gitleaks >/dev/null || { echo "pre-commit: gitleaks is not installed" >&2; exit 1; }
gitleaks protect --staged --config .gitleaks.toml --redact --no-banner
# Env files must never be staged; only *.env.example templates.
if git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)(\.env|[^/]*\.env)$' | grep -vE '\.env\.example$'; then
  echo "pre-commit: refusing env files listed above" >&2
  exit 1
fi
# Real hostnames, domains and paths never enter Git (patterns: local/).
bash scripts/check-private.sh --staged
