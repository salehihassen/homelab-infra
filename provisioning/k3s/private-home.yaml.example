# Copy to local/private-home.yaml; fill in after host/network discovery.
# Install as /etc/rancher/k3s/config.yaml on the PRIVATE server only.
node-name: private-server
node-ip: REPLACE_WITH_PRIVATE_SERVER_TAILSCALE_IPV4
tls-san:
  - REPLACE_WITH_PRIVATE_SERVER_TAILSCALE_IPV4
node-label:
  - homelab.example/cluster=private-home
# Illustrative only: must not overlap any host/Docker/LAN/VPN/provider routes.
cluster-cidr: 10.142.0.0/16
service-cidr: 10.143.0.0/16
cluster-dns: 10.143.0.10
disable:
  - traefik
  - servicelb
flannel-backend: vxlan
secrets-encryption: true
write-kubeconfig-mode: "0600"
