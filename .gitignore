# Settings and secrets never enter Git. Hosts keep them under /opt, backed up
# by restic; only *.env.example templates are tracked (see RUNBOOK.md).
.env
*.env
!.env.example
!*.env.example
secrets/
*.key
*.pem
!**/testdata/**

# Host-specific values that identify this deployment (see README.md).
/local/
*.local.yaml

# Media runtime state and private migration evidence are never source files.
/hosts/server-1/media-extract/config/
/hosts/server-1/media-extract/data/
/hosts/server-1/media-extract/migration/
/hosts/server-1/media-extract/evidence/
/hosts/server-1/media-extract/backup/restic-password

# Local tooling.
__pycache__/
*.pyc
/.venv/
/tmp/
