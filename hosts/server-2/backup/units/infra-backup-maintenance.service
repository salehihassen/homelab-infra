[Unit]
Description=Encrypted host maintenance with shared Restic tooling

[Service]
Type=oneshot
EnvironmentFile=/opt/infra-backup/backup.env
ExecStart=/usr/bin/python3 ${INFRA_DIR}/backup/run.py --settings /opt/infra-backup/backup.env maintenance
TimeoutStartSec=3h
TimeoutStopSec=5min
KillMode=mixed
UMask=0077
Nice=10
