INFRA_DIR=/path/to/homelab-infra
INFRA_HOST=server-2
BACKUP_HOST=server-2
BACKUP_STATE_DIR=/opt/infra-backup-state
RESTIC_REPOSITORY=rclone:b2-server-2:replace-with-bucket/restic/server-2
RESTIC_PASSWORD_FILE=/opt/infra-backup/secrets/b2-password
RCLONE_CONFIG=/opt/infra-backup/secrets/rclone.conf
RESTIC_CACHE_DIR=/opt/infra-backup-state/cache
BACKUP_TOOL_CONFIG=/opt/infra-backup/tool.json
BACKUP_ARCHIVE_DETACHED=0
