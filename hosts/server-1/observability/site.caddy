https://{$GRAFANA_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	reverse_proxy http://127.0.0.1:13000 {
		header_up -Tailscale-*
	}
}

# Loki log API, tailnet-only like the other private sites.
https://{$LOKI_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	# Write-only door: log writers authenticate, and only push/readiness paths
	# exist here. Reads stay behind Grafana's login over the docker network.
	@push path /loki/api/v1/push /ready
	handle @push {
		basic_auth {
			logshipper {$LOKI_WRITER_PASSWORD_HASH}
		}
		reverse_proxy http://127.0.0.1:3100 {
			header_up -Tailscale-*
		}
	}
	handle {
		respond "log push endpoint only; read logs via {$GRAFANA_DOMAIN}" 403
	}
}

# OTLP/HTTP ingest for agent telemetry, tailnet-only like the other sites.
https://{$OTEL_DOMAIN} {
	bind {$CADDY_BIND_ADDRESSES}

	# Write-only door: one Basic-auth account per writer, and only the three
	# OTLP signal paths. Accounts are `<user> <bcrypt hash>` lines in untracked
	# files under /opt/observability/otel-writers (see README). Reads stay
	# behind Grafana and Langfuse logins.
	@otlp path /v1/traces /v1/logs /v1/metrics
	handle @otlp {
		basic_auth {
			import /etc/caddy/otel-writers/*.caddy
		}
		request_body {
			max_size 16MB
		}
		reverse_proxy http://127.0.0.1:4318 {
			header_up -Tailscale-*
		}
	}
	handle {
		respond "OTLP push endpoint only; read telemetry via {$GRAFANA_DOMAIN}" 403
	}
}
