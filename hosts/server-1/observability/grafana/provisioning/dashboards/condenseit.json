{
  "uid": "condenseit",
  "title": "Condenseit",
  "tags": [
    "agents",
    "condenseit",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "description": "Condenseit application telemetry. Production events only; full trace trees and per-run sessions are in Langfuse.",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "host_name",
          "stream": "{service_name=\"condenseit\"}",
          "type": 1,
          "refId": "A"
        },
        "definition": "label_values(host_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed digests",
      "type": "stat",
      "description": "Completed run events in the selected range. One event per run; does not rely on process-local counters.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\" |= \"condenseit.digest.completed\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Failed digests",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\" |= \"condenseit.digest.failed\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Model calls",
      "type": "stat",
      "description": "Logical OpenAI-compatible calls. Rate-limit retries are recorded inside their generation span.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\" |~ \"condenseit.model.(completed|failed)\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Input tokens including cache",
      "type": "stat",
      "description": "Client-reported tokens; cache tokens are already included and are not added again.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\" |= \"condenseit.model.completed\" | unwrap gen_ai_usage_input_tokens | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Output tokens",
      "type": "stat",
      "description": "Missing usage stays missing. No inferred dollar costs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\" |= \"condenseit.model.completed\" | unwrap gen_ai_usage_output_tokens | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Last successful digest",
      "type": "stat",
      "description": "Unix success time, excluding dry runs. Zero means no success reported. Historical maximum survives a process restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(max_over_time(condenseit_digest_last_success_seconds{service_name=\"condenseit\",host_name=~\"$host\",deployment_environment_name=\"production\"}[48h])) * 1000",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Model call latency (p95)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\" |= \"condenseit.model.completed\" | unwrap duration | __error__=\"\" [$__interval]) by (gen_ai_request_model)",
          "queryType": "range",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Correlated lifecycle events",
      "type": "logs",
      "description": "Each OTLP event carries session_id and trace/span context. In Langfuse filter application=condenseit or tag application:condenseit, then open the session.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"condenseit\",host_name=~\"$host\"} | deployment_environment_name=\"production\"",
          "queryType": "range",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
