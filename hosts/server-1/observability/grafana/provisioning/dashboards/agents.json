{
 "uid": "agents",
 "title": "Agents",
 "tags": [
  "agents",
  "otel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "description": "Coding agents' activity from their OTLP events in Loki. Session trees are in Langfuse.",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "editable": false,
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Machine",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "host_name",
     "stream": "{service_name=~\"claude-code|codex.*|pi\"}",
     "type": 1,
     "refId": "A"
    },
    "definition": "label_values(host_name)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "links": [],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Claude Code cost (USD)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2,
     "displayName": "Total cost"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "sum"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"api_request\" | unwrap cost_usd [$__range]))",
     "legendFormat": "",
     "queryType": "instant",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Sessions",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 9,
    "h": 4
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {"id": "byFrameRefID", "options": "A"},
      "properties": [{"id": "displayName", "value": "Claude Code"}]
     },
     {
      "matcher": {"id": "byFrameRefID", "options": "B"},
      "properties": [{"id": "displayName", "value": "Codex"}]
     },
     {
      "matcher": {"id": "byFrameRefID", "options": "C"},
      "properties": [{"id": "displayName", "value": "pi"}]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "sum"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "count(sum by (session_id) (count_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"user_prompt\" [$__range])))",
     "legendFormat": "claude-code",
     "queryType": "instant",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "count(sum by (conversation_id) (count_over_time({service_name=~\"codex.*\",host_name=~\"$host\"} | event_name=\"codex.user_prompt\" [$__range])))",
     "legendFormat": "codex",
     "queryType": "instant",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service_name=\"pi\",host_name=~\"$host\"} | event_name=\"pi.session.start\" [$__range]))",
     "legendFormat": "pi",
     "queryType": "instant",
     "refId": "C"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Tool calls",
   "description": "Failure counts use the harness tool-success field, not shell exit codes. A nonzero command exit may still be exported as a successful tool call; inspect its output in Loki.",
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 9,
    "h": 4
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {"id": "byFrameRefID", "options": "A"},
      "properties": [{"id": "displayName", "value": "All agents"}]
     },
     {
      "matcher": {"id": "byFrameRefID", "options": "B"},
      "properties": [{"id": "displayName", "value": "Failed"}]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "sum"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service_name=~\"claude-code|codex.*|pi\",host_name=~\"$host\"} | event_name=~\"tool_result|codex.tool_result|pi.tool.execution.end\" [$__range]))",
     "legendFormat": "all agents",
     "queryType": "instant",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service_name=~\"claude-code|codex.*|pi\",host_name=~\"$host\"} | event_name=~\"tool_result|codex.tool_result|pi.tool.execution.end\" | success=\"false\" [$__range]))",
     "legendFormat": "failed",
     "queryType": "instant",
     "refId": "B"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Output tokens by agent and machine",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "interval": "1h",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host_name) (sum_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"api_request\" | unwrap output_tokens [$__interval]))",
     "legendFormat": "claude-code {{host_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host_name) (sum_over_time({service_name=~\"codex.*\",host_name=~\"$host\"} | event_name=\"codex.sse_event\" | event_kind=\"response.completed\" | unwrap output_token_count [$__interval]))",
     "legendFormat": "codex {{host_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host_name) (sum_over_time({service_name=\"pi\",host_name=~\"$host\"} | event_name=\"pi.assistant.message\" | unwrap gen_ai_usage_output_tokens [$__interval]))",
     "legendFormat": "pi {{host_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "C"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Input tokens incl. cache by agent and machine",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "interval": "1h",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host_name) (sum_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"api_request\" | unwrap input_tokens [$__interval])) + sum by (host_name) (sum_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"api_request\" | unwrap cache_read_tokens [$__interval])) + sum by (host_name) (sum_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"api_request\" | unwrap cache_creation_tokens [$__interval]))",
     "legendFormat": "claude-code {{host_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host_name) (sum_over_time({service_name=~\"codex.*\",host_name=~\"$host\"} | event_name=\"codex.sse_event\" | event_kind=\"response.completed\" | unwrap input_token_count [$__interval]))",
     "legendFormat": "codex {{host_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host_name) (sum_over_time({service_name=\"pi\",host_name=~\"$host\"} | event_name=\"pi.assistant.message\" | unwrap gen_ai_usage_input_tokens [$__interval])) + sum by (host_name) (sum_over_time({service_name=\"pi\",host_name=~\"$host\"} | event_name=\"pi.assistant.message\" | unwrap gen_ai_usage_cache_read_input_tokens [$__interval]))",
     "legendFormat": "pi {{host_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "C"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Claude Code cost by model (USD)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "interval": "1h",
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (model) (sum_over_time({service_name=\"claude-code\",host_name=~\"$host\"} | event_name=\"api_request\" | unwrap cost_usd [$__interval]))",
     "legendFormat": "{{model}}",
     "queryType": "range",
     "step": "1h",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Tool calls by agent",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "interval": "1h",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service_name) (count_over_time({service_name=~\"claude-code|codex.*|pi\",host_name=~\"$host\"} | event_name=~\"tool_result|codex.tool_result|pi.tool.execution.end\" [$__interval]))",
     "legendFormat": "{{service_name}}",
     "queryType": "range",
     "step": "1h",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "logs",
   "title": "Prompts",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"claude-code|codex.*|pi\",host_name=~\"$host\"} | event_name=~\"user_prompt|codex.user_prompt|pi.user.message\""
    }
   ]
  },
  {
   "id": 9,
   "type": "logs",
   "title": "Tool results",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"claude-code|codex.*|pi\",host_name=~\"$host\"} | event_name=~\"tool_result|codex.tool_result|pi.tool.execution.end\""
    }
   ]
  },
  {
   "id": 10,
   "type": "logs",
   "title": "Failed tools and API errors",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_name=~\"claude-code|codex.*|pi\",host_name=~\"$host\"} | event_name=~\"tool_result|codex.tool_result|pi.tool.execution.end|api_error|codex.api_request\" | event_name=\"api_error\" or (success=\"false\" or level=~\"(?i)error\")"
    }
   ]
  }
 ]
}
