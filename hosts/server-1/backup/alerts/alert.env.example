# /etc/infra-backup/alert.env (root:root, mode 600). install.sh writes it from
# its --helper argument; edit it there afterwards. Holds no secret: the Discord
# credentials stay in the Ping Me configuration of the --user account.
ALERT_TRANSPORT=ping-me
PING_ME_HELPER=/home/user/path/to/Personal-Ping-Me/scripts/ping_me.py
ALERT_JOBS=infra-backup.service=36h,infra-backup-maintenance.service=8d
ALERT_REPEAT_HOURS=24
