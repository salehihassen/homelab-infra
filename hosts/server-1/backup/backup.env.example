# Copy to /etc/infra-backup/backup.env (root:root, mode 600). Loaded by
# infra-backup.service and infra-backup-maintenance.service.
RESTIC_REPOSITORY=rclone:b2-remote:bucket-name/restic/host
RESTIC_PASSWORD_FILE=/etc/restic/password
RCLONE_CONFIG=/etc/rclone/rclone.conf
RESTIC_CACHE_DIR=/var/cache/infra-backup
# Restic host name and tag. Retention groups snapshots by it: keep the value
# an existing repository already uses.
BACKUP_HOST=host
# This repository's checkout and the hosts/<INFRA_HOST> directory to back up.
INFRA_DIR=/home/user/repos/infra
INFRA_HOST=server-1
