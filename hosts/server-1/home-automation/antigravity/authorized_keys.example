# Replace the CLI home, executable path, username and public key. Keep the forced request identical to command_line.example.yaml.
restrict,from="127.0.0.1,::1",command="test \"$SSH_ORIGINAL_COMMAND\" = \"AGY_CLI_DISABLE_AUTO_UPDATE=true /path/to/agy -p /usage --output-format json\" || exit 64; cd /tmp && exec /usr/bin/flock -n /path/to/cli-home/.cache/antigravity-ha-usage.lock /usr/bin/env -i HOME=/path/to/cli-home USER=replace-with-host-user LOGNAME=replace-with-host-user PATH=/usr/bin:/bin LANG=C.UTF-8 SSH_TTY=antigravity-usage AGY_CLI_DISABLE_AUTO_UPDATE=true BROWSER=/bin/false /usr/bin/timeout --kill-after=5s 90s /path/to/agy -p /usage --output-format json </dev/null" ssh-ed25519 replace-with-public-key ha-antigravity-usage
