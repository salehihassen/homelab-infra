# Settings for export-cpamp-usage.py (no credentials; CPAMP's database is read-only).
CPAMP_USAGE_DB=/path/to/cpa/data/cpamp/usage.sqlite
# Frozen day files and price books; never rewritten. Keep it inside a backed-up path.
CPAMP_USAGE_ARCHIVE=/path/to/cpa/cost-reports/daily
CPAMP_USAGE_OUTPUT=/path/to/home-assistant/config/cpamp_usage.json
CPAMP_USAGE_EXPORTER=/path/to/infra/hosts/server-1/home-automation/exporters/export-cpamp-usage.py
# Optional IANA zone for day boundaries; defaults to the host's /etc/localtime.
# CPAMP_USAGE_TZ=replace-with-iana-zone
