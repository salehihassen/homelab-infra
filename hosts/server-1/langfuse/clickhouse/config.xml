<!-- Small single-node ClickHouse for Langfuse on a shared host. -->
<clickhouse>
    <!-- Log to stdout only; the container runs as a non-root user. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="remove"/>
        <errorlog remove="remove"/>
    </logger>
    <!-- Low-memory settings: smaller caches. Background pools keep their
         defaults: MergeTree sanity checks reject smaller pools. -->
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>16777216</uncompressed_cache_size>
    <!-- System log tables grow quickly and are not needed here. -->
    <query_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <part_log remove="remove"/>
    <trace_log remove="remove"/>
    <text_log remove="remove"/>
    <metric_log remove="remove"/>
    <latency_log remove="remove"/>
    <error_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <session_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <backup_log remove="remove"/>
    <blob_storage_log remove="remove"/>
</clickhouse>
