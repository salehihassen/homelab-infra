# Variable names for the 0600 service env files under /opt/langfuse. Never
# commit real values; generate each with `openssl rand -hex 32` unless noted.
#
# /opt/langfuse/langfuse.env (langfuse-web and langfuse-worker)
DATABASE_URL=postgresql://langfuse:replace-with-password@postgres:5432/langfuse
SALT=replace-with-random-hex
# ENCRYPTION_KEY must be exactly 64 hex characters (openssl rand -hex 32).
ENCRYPTION_KEY=replace-with-random-hex
NEXTAUTH_SECRET=replace-with-random-hex
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=replace-with-random-hex
REDIS_AUTH=replace-with-random-hex
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace-with-minio-root-password
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace-with-minio-root-password
# First start only: organisation, project, admin user and the project's API
# keys (Alloy uses the key pair, from /opt/observability/secrets).
LANGFUSE_INIT_ORG_ID=homelab
LANGFUSE_INIT_ORG_NAME=Homelab
LANGFUSE_INIT_PROJECT_ID=agents
LANGFUSE_INIT_PROJECT_NAME=Agents
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-with-uuid
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-with-uuid
LANGFUSE_INIT_USER_EMAIL=admin@private.example
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=replace-with-random-password
#
# /opt/langfuse/clickhouse.env
#   CLICKHOUSE_PASSWORD (same value as above)
# /opt/langfuse/redis.env
#   REDIS_AUTH and REDISCLI_AUTH (both the same value as REDIS_AUTH above)
# /opt/langfuse/minio.env
#   MINIO_ROOT_USER=langfuse, MINIO_ROOT_PASSWORD (the S3 secret above)
