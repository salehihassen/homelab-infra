# Stack-local Compose interpolation settings.
# Image to pull: :latest follows the source repository's main branch;
# pin :sha-<commit> to hold a version.
EMAIL_ASSIST_IMAGE=ghcr.io/OWNER/email-assist:latest
# Web login name and the mailbox (Proton Mail Bridge) address.
EMAIL_ASSIST_WEB_USERNAME=admin
EMAIL_ASSIST_IMAP_USERNAME=you@example.com
