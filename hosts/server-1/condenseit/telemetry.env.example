# Private runtime file: /opt/condenseit/telemetry.env (mode 0600).
# The standard image includes telemetry dependencies; export is opt-in.
CONDENSEIT_OTEL_ENABLED=false
OTEL_SERVICE_NAME=condenseit
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.private.example
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=host.name=source-host,deployment.environment.name=production
CONDENSEIT_OTEL_ENVIRONMENT=production
# Enable only with collector redaction in place. Limits are characters per field.
CONDENSEIT_OTEL_CAPTURE_CONTENT=true
CONDENSEIT_OTEL_CONTENT_LIMIT=16000
# The entrypoint derives OTEL_EXPORTER_OTLP_HEADERS from the secret file.
