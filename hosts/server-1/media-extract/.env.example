# Validation placeholders only. Pin every deployed image to its verified digest.
MEDIA_PUID=1000
MEDIA_PGID=1000
MEDIA_SUBNET=10.66.16.0/24
MEDIA_TORRENT_ROOT=/opt/media-extract/data/torrent
MEDIA_RIP_ROOT=/opt/media-extract/data/makemkv
MEDIA_DVD_DEVICE=/dev/disk/by-id/replace-with-optical-device
MEDIA_DVD_SG_DEVICE=/dev/makemkv/sg-replace-with-serial
MEDIA_VPN_ENV_FILE=./vpn.env.example
MEDIA_GLUETUN_IMAGE=qmcgaw/gluetun:v3
MEDIA_QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:latest
MEDIA_PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:latest
MEDIA_FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:latest
MEDIA_SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
MEDIA_RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
MEDIA_JELLYFIN_IMAGE=lscr.io/linuxserver/jellyfin:latest
MEDIA_MAKEMKV_IMAGE=jlesage/makemkv:latest
MEDIA_HANDBRAKE_IMAGE=jlesage/handbrake:latest
