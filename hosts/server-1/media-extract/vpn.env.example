VPN_SERVICE_PROVIDER=replace-with-provider
VPN_TYPE=openvpn
OPENVPN_USER=replace-with-user
OPENVPN_PASSWORD=replace-with-password
OPENVPN_PROTOCOL=udp
SERVER_COUNTRIES=replace-with-country
VPN_PORT_FORWARDING=off
PORT_FORWARD_ONLY=off
# Gluetun control API authentication. Keep the real values in the private file.
HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE={"auth":"basic","username":"replace-with-user","password":"replace-with-password"}
